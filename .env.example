# La Ruta — copy to .env.local for dev. Never commit real values.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgresql://user:pass@localhost:5432/la_ruta   # its OWN database, not Hunt's
AUTH_SESSION_SECRET=                                         # >= 32 random chars (openssl rand -base64 48)
# Required in production (nonce replay protection + shared rate limits):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# ...or a plain Redis (e.g. Railway Redis) instead of Upstash:
# REDIS_URL=redis://default:pass@host:6379

# --- Same wallet as Hunt (do not change) ------------------------------------
NEXT_PUBLIC_RP_ID=empowertours.xyz                           # "localhost" for local dev (gives a different wallet)
NEXT_PUBLIC_APP_URL=https://ruta.empowertours.xyz

# --- X API (pay-per-use app under @EmpowerTours) ----------------------------
# Leave empty for mock mode in dev. In production, missing keys = X disabled.
X_CLIENT_ID=
X_CLIENT_SECRET=                                             # confidential client
X_BEARER_TOKEN=                                              # app-only bearer
X_REDIRECT_URI=https://ruta.empowertours.xyz/api/la-ruta/x/callback
X_API_MONTHLY_CAP_USD=150                                    # spend guard; calls stop at the cap
# X_MODE=mock                                                # force mock (ignored in production)
# X_TARGET_USER_ID=1779415212614963200                       # @EmpowerTours
# X_TARGET_USERNAME=empowertours

# --- Campaign ---------------------------------------------------------------
LA_RUTA_START=2026-10-29T00:00:00-06:00
LA_RUTA_END=2026-12-10T23:59:59-06:00
# LA_RUTA_RECHECK_HOURS=24
# LA_RUTA_PICKS_PER_WEEK=3
# LA_RUTA_PICKS_TOTAL=20
# LA_RUTA_MAX_SUBMISSIONS_PER_DAY=1
# LA_RUTA_MAX_SUBMISSIONS_PER_WEEK=5

# --- Admin / review / cron --------------------------------------------------
LA_RUTA_ADMIN_WALLETS=                                       # comma-separated passkey wallets
LA_RUTA_REVIEW_TOKEN=                                        # Reach's bearer (>= 32 chars)
CRON_SECRET=                                                 # >= 32 chars

# --- Eligibility ------------------------------------------------------------
MONAD_RPC_URL=                                               # optional; defaults to rpc.monad.xyz (+ rpc2 fallback)
# LA_RUTA_ONCHAIN=off                                        # skip Monad reads (tests/offline)
HUNT_ELIGIBILITY_URL=                                        # STUB: not built in Hunt yet
HUNT_ELIGIBILITY_TOKEN=
DIME_CLAIM_URL=https://hunt.empowertours.xyz/dime
